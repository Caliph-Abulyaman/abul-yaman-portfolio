---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactCTA from "../components/ContactCTA.astro";
import PageVisual from "../components/PageVisual.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { featuredProjects, otherProjects } from "../data/projects";
---

<BaseLayout
  title="Projects"
  description="Selected private client work, pSEO infrastructure, and product design work by Laravel developer Abul Yaman."
>
  <section class="page-hero section page-hero--projects">
    <div class="container page-hero__grid">
      <div class="page-hero__content">
        <p class="eyebrow">Projects</p>
        <h1>Real systems, presented honestly.</h1>
        <p class="page-hero__lead">
          A selection of private client work and product work in progress.
          Each card opens a full case study — the problem, the approach, and
          what shipped — without exposing private code, client data, or
          unreleased mechanics.
        </p>
      </div>

      <div class="page-hero__visual">
        <PageVisual variant="projects" />
      </div>
    </div>
  </section>

  <section class="section project-grid-section">
    <div class="container">
      <p class="mini-label">Featured</p>
      <div class="project-grid project-grid--featured">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>

      {otherProjects.length > 0 && (
        <>
          <p class="mini-label project-grid__more-label">More</p>
          <div class="project-grid">
            {otherProjects.map((project) => <ProjectCard project={project} />)}
          </div>
        </>
      )}
    </div>
  </section>

  <ContactCTA />
</BaseLayout>

<style>
  .project-grid-section {
    padding-top: 2rem;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.1rem;
  }

  .project-grid--featured {
    margin-bottom: 3rem;
  }

  .project-grid__more-label {
    margin-top: 0;
  }

  @media (max-width: 980px) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 720px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
