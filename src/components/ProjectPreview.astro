---
import type { ProjectPreviewVariant } from "../data/projects";

interface Props {
  variant: ProjectPreviewVariant;
  label?: string;
}

const { variant, label } = Astro.props;
---

<div class:list={["project-preview", `project-preview--${variant}`]}>
  {variant === "dashboard" && (
    <div class="preview-huzaifa">
      <section class="preview-huzaifa__public">
        <div class="preview-huzaifa__public-topbar">
          <div class="preview-huzaifa__brand">
            <span>HR</span>
            <div>
              <strong>Huzaifa</strong>
              <small>English learning</small>
            </div>
          </div>

          <div class="preview-huzaifa__nav" aria-hidden="true">
            <i></i>
            <i></i>
            <i></i>
          </div>
        </div>

        <div class="preview-huzaifa__public-body">
          <div class="preview-huzaifa__public-copy">
            <span>LEARNING WITH STRUCTURE</span>
            <strong>English learning with a visible path.</strong>
            <p>Public courses, guided enrolment, and a clear next step for every learner.</p>
            <em>Explore courses <i>→</i></em>
          </div>

          <div class="preview-huzaifa__public-courses" aria-hidden="true">
            <span>COURSES</span>
            <div><i></i><b>Speaking</b></div>
            <div><i></i><b>Writing</b></div>
            <div><i></i><b>Grammar</b></div>
          </div>
        </div>
      </section>

      <section class="preview-huzaifa__admin">
        <div class="preview-huzaifa__admin-topbar">
          <div>
            <span>ADMIN WORKSPACE</span>
            <strong>Operations overview</strong>
          </div>
          <div class="preview-huzaifa__admin-user" aria-hidden="true">
            <i></i>
            <b>HU</b>
          </div>
        </div>

        <div class="preview-huzaifa__metrics" aria-hidden="true">
          <div><span>COURSES</span><i></i></div>
          <div><span>LEARNERS</span><i></i></div>
          <div><span>GRADING</span><i></i></div>
        </div>

        <div class="preview-huzaifa__quick-actions" aria-hidden="true">
          <span><i></i>Schedule</span>
          <span><i></i>Enrol</span>
          <span><i></i>Review</span>
        </div>

        <div class="preview-huzaifa__admin-grid">
          <div class="preview-huzaifa__session-list">
            <div class="preview-huzaifa__sheet-heading">
              <b>Upcoming sessions</b>
              <i></i>
            </div>
            <div><span class="preview-huzaifa__session-icon"></span><p><b>Session details</b><small>Course, time, meeting</small></p><em>→</em></div>
            <div><span class="preview-huzaifa__session-icon"></span><p><b>Course control</b><small>Capacity and status</small></p><em>→</em></div>
          </div>

          <div class="preview-huzaifa__activity-list">
            <div class="preview-huzaifa__sheet-heading">
              <b>Activity</b>
              <i></i>
            </div>
            <div><span></span><p>New enrolment</p></div>
            <div><span></span><p>Feedback to review</p></div>
            <div><span></span><p>Message received</p></div>
          </div>
        </div>
      </section>

      <section class="preview-huzaifa__workflow">
        <div class="preview-huzaifa__workflow-header">
          <div>
            <span>PRODUCT WORKFLOWS</span>
            <strong>Courses, sessions, and reviews.</strong>
          </div>
          <i aria-hidden="true"></i>
        </div>

        <div class="preview-huzaifa__workflow-steps" aria-hidden="true">
          <div>
            <span class="preview-huzaifa__workflow-icon preview-huzaifa__workflow-icon--course"></span>
            <p><b>Course catalogue</b><small>Structured offers</small></p>
          </div>
          <div>
            <span class="preview-huzaifa__workflow-icon preview-huzaifa__workflow-icon--session"></span>
            <p><b>Session setup</b><small>Clear scheduling</small></p>
          </div>
          <div>
            <span class="preview-huzaifa__workflow-icon preview-huzaifa__workflow-icon--review"></span>
            <p><b>Review moderation</b><small>Publish with care</small></p>
          </div>
        </div>
      </section>
    </div>
  )}

  {variant === "pseo" && (
    <div class="preview-pseo">
      <section class="preview-pseo__site">
        <div class="preview-pseo__sitebar">
          <div class="preview-pseo__identity">
            <span class="preview-pseo__mark"><i></i></span>
            <strong>LOCAL SEARCH</strong>
          </div>

          <div class="preview-pseo__site-nav">
            <span></span>
            <span></span>
            <span></span>
          </div>
        </div>

        <div class="preview-pseo__public-content">
          <div class="preview-pseo__public-copy">
            <span class="preview-pseo__eyebrow">CITY-LEVEL VISIBILITY</span>
            <strong>Findable where customers are searching.</strong>
            <p>Structured service pages for every market you serve.</p>
            <div class="preview-pseo__public-actions">
              <span><i></i>Build coverage</span>
              <em>Search-ready structure</em>
            </div>
          </div>

          <div class="preview-pseo__search-card">
            <div class="preview-pseo__search-bar">
              <i></i>
              <span>service + city</span>
              <b></b>
            </div>
            <div class="preview-pseo__search-result">
              <span>LOCAL RESULT</span>
              <strong>Service page for a selected area</strong>
              <i></i>
              <i></i>
              <i></i>
            </div>
          </div>
        </div>
      </section>

      <section class="preview-pseo__workspace">
        <aside class="preview-pseo__workspace-sidebar">
          <div class="preview-pseo__workspace-brand"><i></i></div>
          <span class="preview-pseo__workspace-nav preview-pseo__workspace-nav--active"></span>
          <span class="preview-pseo__workspace-nav"></span>
          <span class="preview-pseo__workspace-nav"></span>
          <span class="preview-pseo__workspace-nav"></span>
          <small>Workspace</small>
        </aside>

        <div class="preview-pseo__workspace-main">
          <div class="preview-pseo__workspace-topline">
            <div>
              <span>SEARCH WORKSPACE</span>
              <strong>City page control</strong>
            </div>
            <i></i>
          </div>

          <div class="preview-pseo__readiness-row">
            <div>
              <span class="preview-pseo__readiness-icon preview-pseo__readiness-icon--green"></span>
              <small>Coverage</small>
              <strong>Selected</strong>
            </div>
            <div>
              <span class="preview-pseo__readiness-icon preview-pseo__readiness-icon--amber"></span>
              <small>Quality</small>
              <strong>Review</strong>
            </div>
            <div>
              <span class="preview-pseo__readiness-icon preview-pseo__readiness-icon--blue"></span>
              <small>Publish</small>
              <strong>Controlled</strong>
            </div>
          </div>

          <div class="preview-pseo__workspace-grid">
            <div class="preview-pseo__setup-card">
              <span>SETUP PATH</span>
              <strong>Business, cities, services.</strong>
              <div class="preview-pseo__setup-steps">
                <i class="is-ready"></i>
                <i class="is-ready"></i>
                <i></i>
              </div>
            </div>

            <div class="preview-pseo__batch-card">
              <span>CREATE CAREFULLY</span>
              <strong>Generate a review batch.</strong>
              <em><i></i>Quality checks before scale</em>
            </div>
          </div>
        </div>
      </section>
    </div>
  )}

  {variant === "fantivers" && (
    <div class="preview-fantivers">
      <div class="preview-fantivers__glow preview-fantivers__glow--one"></div>
      <div class="preview-fantivers__glow preview-fantivers__glow--two"></div>

      <div class="preview-fantivers__topbar">
        <span>FANTIVERS</span>
        <i></i>
        <i></i>
      </div>

      <div class="preview-fantivers__world">
        <div class="preview-fantivers__node preview-fantivers__node--core">
          <span>THE<br />WORLD</span>
        </div>

        <div class="preview-fantivers__node preview-fantivers__node--one">
          <span>STORY<br />ARC</span>
        </div>

        <div class="preview-fantivers__node preview-fantivers__node--two">
          <span>CHARACTER<br />THREAD</span>
        </div>

        <div class="preview-fantivers__node preview-fantivers__node--three">
          <span>LORE<br />ENTRY</span>
        </div>

        <div class="preview-fantivers__line preview-fantivers__line--one"></div>
        <div class="preview-fantivers__line preview-fantivers__line--two"></div>
        <div class="preview-fantivers__line preview-fantivers__line--three"></div>
      </div>

      <div class="preview-fantivers__tags">
        <span>WORLD</span>
        <span>STORY</span>
        <span>CREATION</span>
      </div>
    </div>
  )}

  {label && <span class="project-preview__label">{label}</span>}
</div>

<style>
  .project-preview {
    position: relative;
    min-height: 320px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 1.5rem;
    background: var(--surface-soft);
  }

  .project-preview__label {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 8;
    padding: 0.48rem 0.7rem;
    border: 1px solid rgb(255 255 255 / 14%);
    border-radius: 999px;
    background: rgb(16 24 38 / 82%);
    color: #fff;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    backdrop-filter: blur(10px);
  }

  /* Huzaifa Portal product-surface preview
     Translates the public learning site and private operating system into a
     portfolio-safe visual. It abstracts course delivery, enrolment, session
     setup, review moderation, notifications, and administration rather than
     reproducing a literal application screenshot. */

  .project-preview--dashboard {
    padding: 0.85rem;
    background:
      radial-gradient(circle at 9% 12%, rgb(238 179 35 / 22%), transparent 26%),
      radial-gradient(circle at 87% 88%, rgb(42 92 145 / 15%), transparent 34%),
      linear-gradient(145deg, #e8edf4 0%, #f8f7f2 54%, #e8ebee 100%);
  }

  .preview-huzaifa {
    position: relative;
    min-height: 300px;
    height: 100%;
    overflow: hidden;
    border: 1px solid rgb(16 24 38 / 12%);
    border-radius: 1rem;
    background:
      linear-gradient(rgb(30 56 92 / 4%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(30 56 92 / 4%) 1px, transparent 1px),
      #eff2f5;
    background-size: 1.35rem 1.35rem, 1.35rem 1.35rem, auto;
    box-shadow: 0 24px 50px rgb(16 24 38 / 12%);
  }

  .preview-huzaifa__public,
  .preview-huzaifa__admin,
  .preview-huzaifa__workflow {
    position: absolute;
    overflow: hidden;
    border: 1px solid rgb(16 24 38 / 11%);
    box-shadow: 0 0.85rem 1.75rem rgb(16 24 38 / 13%);
  }

  .preview-huzaifa__public {
    top: 0.7rem;
    left: 0.7rem;
    width: 59%;
    min-height: 164px;
    padding: 0.68rem;
    border-radius: 0.7rem;
    background:
      linear-gradient(rgb(255 255 255 / 4%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 4%) 1px, transparent 1px),
      radial-gradient(circle at 82% 20%, rgb(217 167 48 / 16%), transparent 31%),
      #0f1d33;
    background-size: 1.15rem 1.15rem, 1.15rem 1.15rem, auto, auto;
  }

  .preview-huzaifa__public-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.52rem;
    border-bottom: 1px solid rgb(255 255 255 / 10%);
  }

  .preview-huzaifa__brand {
    display: flex;
    align-items: center;
    gap: 0.38rem;
  }

  .preview-huzaifa__brand > span {
    display: grid;
    width: 1.15rem;
    height: 1.15rem;
    place-items: center;
    border-radius: 50%;
    background: #e6aa24;
    color: #0f1d33;
    font-family: var(--font-body);
    font-size: 0.35rem;
    font-weight: 900;
  }

  .preview-huzaifa__brand div {
    display: grid;
    gap: 0.04rem;
  }

  .preview-huzaifa__brand strong {
    color: #fffdfa;
    font-family: var(--font-display);
    font-size: 0.54rem;
    font-weight: 400;
    line-height: 1;
  }

  .preview-huzaifa__brand small,
  .preview-huzaifa__public-copy > span,
  .preview-huzaifa__public-courses > span,
  .preview-huzaifa__admin-topbar span,
  .preview-huzaifa__workflow-header span {
    font-family: var(--font-body);
    font-size: 0.28rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .preview-huzaifa__brand small {
    color: rgb(255 255 255 / 52%);
    letter-spacing: 0.04em;
  }

  .preview-huzaifa__nav {
    display: flex;
    align-items: center;
    gap: 0.28rem;
  }

  .preview-huzaifa__nav i {
    display: block;
    width: 0.72rem;
    height: 0.18rem;
    border-radius: 99px;
    background: rgb(255 255 255 / 28%);
  }

  .preview-huzaifa__nav i:last-child {
    width: 0.95rem;
    height: 0.46rem;
    border-radius: 0.12rem;
    background: #e6aa24;
  }

  .preview-huzaifa__public-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 4.15rem;
    gap: 0.5rem;
    padding-top: 0.66rem;
  }

  .preview-huzaifa__public-copy {
    display: grid;
    align-content: start;
  }

  .preview-huzaifa__public-copy > span {
    color: #e6aa24;
  }

  .preview-huzaifa__public-copy > strong {
    max-width: 7rem;
    margin-top: 0.3rem;
    color: #fffdfa;
    font-family: var(--font-display);
    font-size: clamp(0.9rem, 2.55vw, 1.28rem);
    font-weight: 400;
    line-height: 0.98;
  }

  .preview-huzaifa__public-copy > p {
    max-width: 7.5rem;
    margin: 0.38rem 0 0;
    color: rgb(255 255 255 / 63%);
    font-size: 0.36rem;
    line-height: 1.42;
  }

  .preview-huzaifa__public-copy > em {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    width: fit-content;
    margin-top: 0.52rem;
    padding: 0.33rem 0.4rem;
    border-radius: 0.16rem;
    background: #e6aa24;
    color: #10213b;
    font-family: var(--font-body);
    font-size: 0.3rem;
    font-style: normal;
    font-weight: 900;
  }

  .preview-huzaifa__public-copy > em i {
    font-size: 0.45rem;
    font-style: normal;
    line-height: 0;
  }

  .preview-huzaifa__public-courses {
    display: grid;
    align-content: start;
    gap: 0.28rem;
    padding: 0.45rem;
    border: 1px solid rgb(255 255 255 / 12%);
    border-radius: 0.42rem;
    background: rgb(255 255 255 / 6%);
  }

  .preview-huzaifa__public-courses > span {
    color: rgb(255 255 255 / 47%);
  }

  .preview-huzaifa__public-courses > div {
    display: flex;
    align-items: center;
    gap: 0.22rem;
    padding-top: 0.23rem;
    border-top: 1px solid rgb(255 255 255 / 10%);
  }

  .preview-huzaifa__public-courses > div i {
    display: block;
    width: 0.34rem;
    height: 0.34rem;
    border-radius: 0.1rem;
    background: rgb(230 170 36 / 88%);
  }

  .preview-huzaifa__public-courses > div:nth-child(3) i { background: #9d79f5; }
  .preview-huzaifa__public-courses > div:nth-child(4) i { background: #5d95ed; }

  .preview-huzaifa__public-courses > div b {
    color: rgb(255 255 255 / 80%);
    font-family: var(--font-body);
    font-size: 0.29rem;
    font-weight: 800;
  }

  .preview-huzaifa__admin {
    z-index: 2;
    top: 2.32rem;
    right: 0.7rem;
    bottom: 0.7rem;
    width: 59%;
    min-height: 207px;
    padding: 0.68rem;
    border-radius: 0.68rem;
    background: #fffefa;
  }

  .preview-huzaifa__admin-topbar {
    display: flex;
    align-items: start;
    justify-content: space-between;
    padding-bottom: 0.48rem;
    border-bottom: 1px solid #e7e9ea;
  }

  .preview-huzaifa__admin-topbar > div:first-child {
    display: grid;
    gap: 0.1rem;
  }

  .preview-huzaifa__admin-topbar span,
  .preview-huzaifa__workflow-header span {
    color: #4eab77;
  }

  .preview-huzaifa__admin-topbar strong,
  .preview-huzaifa__workflow-header strong {
    color: #17233a;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1;
  }

  .preview-huzaifa__admin-user {
    display: flex;
    align-items: center;
    gap: 0.28rem;
  }

  .preview-huzaifa__admin-user > i {
    position: relative;
    display: block;
    width: 0.62rem;
    height: 0.62rem;
    border: 2px solid #738091;
    border-radius: 0.25rem 0.25rem 0.35rem 0.35rem;
  }

  .preview-huzaifa__admin-user > i::after {
    content: "";
    position: absolute;
    top: -0.2rem;
    right: -0.16rem;
    width: 0.26rem;
    height: 0.26rem;
    border: 1px solid #fffefa;
    border-radius: 50%;
    background: #e65757;
  }

  .preview-huzaifa__admin-user > b {
    display: grid;
    width: 0.78rem;
    height: 0.78rem;
    place-items: center;
    border-radius: 50%;
    background: #122f5c;
    color: #f2c147;
    font-family: var(--font-body);
    font-size: 0.27rem;
    font-weight: 900;
  }

  .preview-huzaifa__metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.28rem;
    margin-top: 0.48rem;
  }

  .preview-huzaifa__metrics > div {
    display: grid;
    gap: 0.23rem;
    padding: 0.33rem;
    border: 1px solid #edf0f1;
    border-radius: 0.25rem;
    background: #fbfcfd;
  }

  .preview-huzaifa__metrics span {
    color: #8b96a2;
    font-family: var(--font-body);
    font-size: 0.22rem;
    font-weight: 900;
    letter-spacing: 0.06em;
  }

  .preview-huzaifa__metrics i {
    display: block;
    width: 65%;
    height: 0.38rem;
    border-radius: 0.12rem;
    background: linear-gradient(90deg, #173e75 0 50%, #dde7f8 50% 100%);
  }

  .preview-huzaifa__metrics > div:nth-child(2) i {
    background: linear-gradient(90deg, #9a4ce7 0 45%, #f0e4fb 45% 100%);
  }

  .preview-huzaifa__metrics > div:nth-child(3) i {
    background: linear-gradient(90deg, #dc9c1e 0 62%, #fff1d3 62% 100%);
  }

  .preview-huzaifa__quick-actions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.28rem;
    margin-top: 0.38rem;
  }

  .preview-huzaifa__quick-actions span {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.18rem;
    min-height: 0.8rem;
    border: 1px solid #dbe7fb;
    border-radius: 0.22rem;
    background: #f7faff;
    color: #315ca8;
    font-family: var(--font-body);
    font-size: 0.24rem;
    font-weight: 900;
  }

  .preview-huzaifa__quick-actions span:nth-child(2) {
    border-color: #e5d8fa;
    background: #fbf8ff;
    color: #8644d0;
  }

  .preview-huzaifa__quick-actions span:nth-child(3) {
    border-color: #ffe4a8;
    background: #fffaf0;
    color: #b8740b;
  }

  .preview-huzaifa__quick-actions i {
    display: block;
    width: 0.3rem;
    height: 0.3rem;
    border: 1px solid currentColor;
    border-radius: 0.08rem;
  }

  .preview-huzaifa__admin-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 0.32rem;
    margin-top: 0.42rem;
  }

  .preview-huzaifa__session-list,
  .preview-huzaifa__activity-list {
    padding: 0.38rem;
    border: 1px solid #e8eced;
    border-radius: 0.32rem;
    background: #fff;
  }

  .preview-huzaifa__sheet-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.28rem;
    border-bottom: 1px solid #edf0f0;
  }

  .preview-huzaifa__sheet-heading > b {
    color: #233451;
    font-family: var(--font-body);
    font-size: 0.28rem;
    font-weight: 900;
  }

  .preview-huzaifa__sheet-heading > i {
    display: block;
    width: 0.4rem;
    height: 0.2rem;
    border-radius: 99px;
    background: #173e75;
  }

  .preview-huzaifa__session-list > div:not(:first-child) {
    display: grid;
    grid-template-columns: 0.54rem 1fr 0.35rem;
    align-items: center;
    gap: 0.2rem;
    padding-top: 0.26rem;
  }

  .preview-huzaifa__session-icon {
    display: block;
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 0.14rem;
    background: #e7efff;
  }

  .preview-huzaifa__session-list p,
  .preview-huzaifa__activity-list p,
  .preview-huzaifa__workflow-steps p {
    display: grid;
    gap: 0.05rem;
    margin: 0;
  }

  .preview-huzaifa__session-list b,
  .preview-huzaifa__workflow-steps b {
    color: #415067;
    font-family: var(--font-body);
    font-size: 0.24rem;
    font-weight: 900;
    line-height: 1.15;
  }

  .preview-huzaifa__session-list small,
  .preview-huzaifa__workflow-steps small {
    color: #99a3ae;
    font-family: var(--font-body);
    font-size: 0.21rem;
    line-height: 1.1;
  }

  .preview-huzaifa__session-list em {
    color: #5373a6;
    font-size: 0.43rem;
    font-style: normal;
    line-height: 1;
  }

  .preview-huzaifa__activity-list > div:not(:first-child) {
    display: grid;
    grid-template-columns: 0.3rem 1fr;
    align-items: center;
    gap: 0.17rem;
    padding-top: 0.26rem;
  }

  .preview-huzaifa__activity-list > div:not(:first-child) > span {
    display: block;
    width: 0.24rem;
    height: 0.24rem;
    border-radius: 50%;
    background: #edb21b;
  }

