---
export type PageVisualVariant = "about" | "projects" | "services" | "resume" | "contact" | "journey" | "ai-practice";

interface Props {
  variant: PageVisualVariant;
}

const { variant } = Astro.props;
---

<div class:list={["page-visual", `page-visual--${variant}`]} aria-hidden="true">
  {variant === "about" && (
    <div class="about-visual">
      <div class="about-visual__heading">
        <span>Developer operating system</span>
        <i></i>
      </div>

      <div class="about-visual__orbit">
        <div class="about-visual__core">REFINE</div>
        <span class="about-visual__node about-visual__node--one">Workflow</span>
        <span class="about-visual__node about-visual__node--two">Data</span>
        <span class="about-visual__node about-visual__node--three">Experience</span>
        <span class="about-visual__node about-visual__node--four">Judgment</span>
      </div>

      <div class="about-visual__footer">
        <span>BUILD</span>
        <i></i>
        <span>TEST</span>
        <i></i>
        <span>IMPROVE</span>
      </div>
    </div>
  )}

  {variant === "projects" && (
    <div class="projects-visual">
      <div class="projects-visual__label">Project atlas</div>

      <div class="atlas-card atlas-card--portal">
        <span>HUZAIFA PORTAL</span>
        <div class="atlas-card__portal-layout">
          <i></i>
          <div>
            <b></b>
            <em></em>
            <em></em>
            <em></em>
          </div>
        </div>
      </div>

      <div class="atlas-card atlas-card--pseo">
        <span>pSEO ENGINE</span>
        <div class="atlas-card__pseo-layout">
          <b></b>
          <i></i>
          <i></i>
          <em></em>
          <em></em>
        </div>
      </div>

      <div class="atlas-card atlas-card--fantivers">
        <span>FANTIVERS</span>
        <div class="atlas-card__world">
          <i></i>
          <i></i>
          <i></i>
          <b></b>
        </div>
      </div>

      <p>Three systems. Different operating models.</p>
    </div>
  )}

  {variant === "services" && (
    <div class="services-visual">
      <div class="services-visual__heading">
        <span>Product capability stack</span>
        <i></i>
      </div>

      <ol class="services-visual__flow">
        <li><span>01</span><strong>Plan</strong></li>
        <li><span>02</span><strong>Structure</strong></li>
        <li><span>03</span><strong>Build</strong></li>
        <li><span>04</span><strong>Manage</strong></li>
        <li><span>05</span><strong>Deploy</strong></li>
        <li><span>06</span><strong>Grow</strong></li>
      </ol>

      <p>Connected work, not disconnected deliverables.</p>
    </div>
  )}

  {variant === "resume" && (
    <div class="resume-visual">
      <div class="resume-visual__top">
        <span>AY</span>
        <p>Professional profile</p>
      </div>

      <h2>Abul Yaman</h2>
      <strong>Laravel Developer</strong>

      <dl>
        <div>
          <dt>Based</dt>
          <dd>KP, Pakistan</dd>
        </div>
        <div>
          <dt>Focus</dt>
          <dd>Systems / SaaS / Search</dd>
        </div>
        <div>
          <dt>Status</dt>
          <dd>Selected work & internships</dd>
        </div>
      </dl>

      <div class="resume-visual__matrix">
        <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
      </div>
    </div>
  )}

  {variant === "journey" && (
    <div class="journey-visual">
      <div class="journey-visual__heading">
        <span>The road so far</span>
        <i></i>
      </div>

      <div class="journey-visual__spine">
        <div class="journey-visual__line"></div>

        <span class="journey-visual__node journey-visual__node--one journey-visual__node--left">
          <b>01</b><em>Grade 9</em>
        </span>
        <span class="journey-visual__node journey-visual__node--two">
          <b>02</b><em>CS50 / CS75</em>
        </span>
        <span class="journey-visual__node journey-visual__node--three journey-visual__node--left">
          <b>03</b><em>Laravel</em>
        </span>
        <span class="journey-visual__node journey-visual__node--four">
          <b>04</b><em>Production systems</em>
        </span>
        <span class="journey-visual__node journey-visual__node--five journey-visual__node--left">
          <b>05</b><em>DevOps track</em>
        </span>
      </div>

      <p>Not handed to me — each milestone built by hand.</p>
    </div>
  )}

  {variant === "ai-practice" && (
    <div class="ai-visual">
      <div class="ai-visual__heading">
        <span>Methodology, not autopilot</span>
        <i></i>
      </div>

      <div class="ai-visual__orbit">
        <div class="ai-visual__core">JUDGMENT</div>
        <span class="ai-visual__node ai-visual__node--one">Explain → Hint → Task</span>
        <span class="ai-visual__node ai-visual__node--two">Friction first</span>
        <span class="ai-visual__node ai-visual__node--three">Verify, don't assume</span>
        <span class="ai-visual__node ai-visual__node--four">Errors drilled</span>
      </div>

      <div class="ai-visual__footer">
        <span>I write every line</span>
        <i></i>
        <span>No unsolicited code</span>
      </div>
    </div>
  )}

  {variant === "contact" && (
    <div class="contact-visual">
      <div class="contact-visual__heading">
        <span>Useful project brief</span>
        <i></i>
      </div>

      <h2>Start with the essentials.</h2>

      <ol>
        <li>
          <span>01</span>
          <div><strong>Goal</strong><small>What needs to work?</small></div>
        </li>
        <li>
          <span>02</span>
          <div><strong>Users</strong><small>Who will use it?</small></div>
        </li>
        <li>
          <span>03</span>
          <div><strong>Features</strong><small>What is required first?</small></div>
        </li>
        <li>
          <span>04</span>
          <div><strong>Timeline</strong><small>When is it needed?</small></div>
        </li>
      </ol>
    </div>
  )}
</div>

<style>
  .page-visual {
    position: relative;
    width: 100%;
    min-height: 24rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 1.4rem;
    box-shadow: var(--shadow-soft);
  }

  .page-visual--about {
    padding: 1.1rem;
    background:
      radial-gradient(circle at 84% 14%, rgb(167 122 59 / 20%), transparent 26%),
      linear-gradient(145deg, #101a2a 0%, #152335 64%, #213044 100%);
  }

  .about-visual {
    position: relative;
    display: grid;
    min-height: 22rem;
    padding: 1rem;
    overflow: hidden;
    border: 1px solid rgb(248 245 238 / 12%);
    border-radius: 1rem;
    background:
      linear-gradient(rgb(248 245 238 / 5%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(248 245 238 / 5%) 1px, transparent 1px),
      radial-gradient(circle at 50% 48%, rgb(167 122 59 / 18%), transparent 34%);
    background-size: 1.45rem 1.45rem, 1.45rem 1.45rem, auto;
  }

  .about-visual__heading,
  .about-visual__footer {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: rgb(248 245 238 / 68%);
    font-family: var(--font-body);
    font-size: 0.54rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .about-visual__heading i,
  .about-visual__footer i {
    display: block;
    width: 1.4rem;
    height: 1px;
    background: #d7bc8e;
  }

  .about-visual__footer {
    align-self: end;
    justify-self: end;
    font-size: 0.48rem;
  }

  .about-visual__orbit {
    position: absolute;
    inset: 2.5rem 2rem 2.1rem;
    border: 1px solid rgb(248 245 238 / 15%);
    border-radius: 50%;
  }

  .about-visual__orbit::before,
  .about-visual__orbit::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 70%;
    height: 1px;
    background: rgb(248 245 238 / 14%);
    content: "";
    transform-origin: center;
  }

  .about-visual__orbit::before {
    transform: translate(-50%, -50%) rotate(38deg);
  }

  .about-visual__orbit::after {
    transform: translate(-50%, -50%) rotate(-38deg);
  }

  .about-visual__core {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    width: 5.6rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid #d7bc8e;
    border-radius: 50%;
    background: #121a27;
    box-shadow: 0 0 0 0.65rem rgb(18 26 39 / 48%);
    color: #f8f5ee;
    font-family: var(--font-body);
    font-size: 0.58rem;
    font-weight: 900;
    letter-spacing: 0.09em;
    transform: translate(-50%, -50%);
  }

  .about-visual__node {
    position: absolute;
    padding: 0.46rem 0.56rem;
    border: 1px solid rgb(248 245 238 / 21%);
    border-radius: 999px;
    background: rgb(16 24 38 / 84%);
    color: #f8f5ee;
    font-family: var(--font-body);
    font-size: 0.5rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .about-visual__node--one { top: -0.15rem; left: 18%; }
  .about-visual__node--two { top: 38%; right: -0.25rem; }
  .about-visual__node--three { bottom: -0.15rem; left: 31%; }
  .about-visual__node--four { top: 39%; left: -0.15rem; }

  .page-visual--projects {
    padding: 1.1rem;
    background:
      radial-gradient(circle at 18% 82%, rgb(167 122 59 / 13%), transparent 25%),
      linear-gradient(140deg, #e9e4da, #f9f7f1);
  }

  .projects-visual {
    position: relative;
    min-height: 22rem;
    padding: 1rem;
    overflow: hidden;
    border: 1px solid rgb(16 24 38 / 8%);
    border-radius: 1rem;
    background:
      linear-gradient(rgb(16 24 38 / 4%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(16 24 38 / 4%) 1px, transparent 1px),
      #f7f4ed;
    background-size: 1.5rem 1.5rem;
  }

  .projects-visual__label {
    color: var(--bronze);
    font-family: var(--font-body);
    font-size: 0.55rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .atlas-card {
    position: absolute;
    overflow: hidden;
    border: 1px solid rgb(16 24 38 / 11%);
    border-radius: 0.75rem;
    box-shadow: 0 18px 35px rgb(16 24 38 / 12%);
  }

  .atlas-card > span {
    position: absolute;
    top: 0.55rem;
    left: 0.65rem;
    z-index: 2;
    font-family: var(--font-body);
    font-size: 0.44rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .atlas-card--portal {
    top: 3rem;
    left: 1.3rem;
    width: 48%;
    aspect-ratio: 1.16;
    background: #fbfaf6;
  }

  .atlas-card--portal > span { color: #727062; }

  .atlas-card__portal-layout {
    display: grid;
    grid-template-columns: 25% 1fr;
    height: 100%;
    padding-top: 1.5rem;
  }

  .atlas-card__portal-layout > i {
    display: block;
    background: #152031;
  }

  .atlas-card__portal-layout > div {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: 18% 1fr;
    gap: 0.3rem;
    padding: 0.8rem;
  }

  .atlas-card__portal-layout b {
    grid-column: 1 / -1;
    width: 74%;
    height: 0.35rem;
    border-radius: 99px;
    background: #d8d4cc;
  }

  .atlas-card__portal-layout em {
    min-height: 1.35rem;
    border-radius: 0.28rem;
    background: #efede8;
  }

  .atlas-card--pseo {
    top: 5rem;
    right: 1.15rem;
    width: 45%;
    aspect-ratio: 1.12;
    background: #eff2e9;
  }

  .atlas-card--pseo > span { color: #66705a; }

  .atlas-card__pseo-layout {
    position: relative;
    height: 100%;
    padding: 2rem 0.8rem 0.8rem;
  }

  .atlas-card__pseo-layout b {
    display: block;
    width: 36%;
    height: 0.28rem;
    margin-bottom: 0.65rem;
    border-radius: 999px;
    background: #698161;
  }

  .atlas-card__pseo-layout i {
    display: block;
    width: 72%;
    height: 0.42rem;
    margin: 0.38rem 0;
    border-radius: 999px;
    background: #ccd4c5;
  }

  .atlas-card__pseo-layout em {
    position: absolute;
    right: 0.8rem;
    width: 30%;
    height: 22%;
    border: 1px solid #dce3d5;
    border-radius: 0.35rem;
    background: #fbfcf9;
  }

  .atlas-card__pseo-layout em:nth-of-type(1) { top: 39%; }
  .atlas-card__pseo-layout em:nth-of-type(2) { bottom: 0.8rem; }

  .atlas-card--fantivers {
    bottom: 2rem;
    left: 22%;
    width: 54%;
    aspect-ratio: 1.55;
    background:
      radial-gradient(circle at 36% 34%, rgb(131 94 201 / 58%), transparent 26%),
      #111c2c;
  }

  .atlas-card--fantivers > span { color: rgb(248 245 238 / 76%); }

  .atlas-card__world {
    position: relative;
    height: 100%;
  }

  .atlas-card__world b,
  .atlas-card__world i {
    position: absolute;
    display: block;
    border: 1px solid rgb(248 245 238 / 35%);
    border-radius: 50%;
  }

  .atlas-card__world b {
    top: 52%;
    left: 50%;
    width: 1.75rem;
    aspect-ratio: 1;
    background: rgb(183 145 94 / 16%);
    transform: translate(-50%, -50%);
  }

  .atlas-card__world i:nth-child(1) { top: 30%; left: 23%; width: 1.2rem; aspect-ratio: 1; }
  .atlas-card__world i:nth-child(2) { right: 17%; bottom: 20%; width: 1.3rem; aspect-ratio: 1; }
  .atlas-card__world i:nth-child(3) { bottom: 15%; left: 28%; width: 0.9rem; aspect-ratio: 1; }

  .projects-visual > p {
    position: absolute;
    right: 1rem;
    bottom: 0.72rem;
    margin: 0;
    color: var(--muted);
    font-family: var(--font-body);
    font-size: 0.47rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .page-visual--services {
    padding: 1.1rem;
    background:
      radial-gradient(circle at 88% 14%, rgb(167 122 59 / 16%), transparent 25%),
      linear-gradient(150deg, #f7f3ea, #e9e4da);
  }

  .services-visual {
    display: grid;
    min-height: 22rem;
    padding: 1.2rem;
    border: 1px solid rgb(16 24 38 / 9%);
    border-radius: 1rem;
    background: rgb(255 253 248 / 70%);
  }

  .services-visual__heading {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--bronze);
    font-family: var(--font-body);
    font-size: 0.56rem;
    font-weight: 900;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .services-visual__heading i {
    width: 1.5rem;
    height: 1px;
    background: currentColor;
  }

  .services-visual__flow {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.65rem;
    align-self: center;
    list-style: none;
  }

  .services-visual__flow::before {
    position: absolute;
    top: 50%;
    right: 2rem;
    left: 2rem;
    z-index: 0;
    height: 1px;
    background: rgb(16 24 38 / 13%);
    content: "";
  }

  .services-visual__flow li {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.65rem;
    min-height: 5rem;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: 0.65rem;
    background: #fffdf8;
  }

  .services-visual__flow li:nth-child(2),
  .services-visual__flow li:nth-child(5) { transform: translateY(0.75rem); }

  .services-visual__flow span {
    color: var(--bronze);
    font-family: var(--font-body);
    font-size: 0.53rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .services-visual__flow strong {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 400;
  }

  .services-visual > p {
    align-self: end;
    margin: 0;
    color: var(--muted);
    font-family: var(--font-body);
    font-size: 0.6rem;
    font-weight: 800;
  }

  .page-visual--resume {
    padding: 1.1rem;
    background:
      radial-gradient(circle at 84% 17%, rgb(167 122 59 / 16%), transparent 26%),
      #152030;
  }

  .resume-visual {
    display: grid;
    min-height: 22rem;
    padding: 1.25rem;
    border: 1px solid rgb(248 245 238 / 12%);
    border-radius: 1rem;
    background: linear-gradient(155deg, rgb(248 245 238 / 7%), transparent 60%);
  }

  .resume-visual__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .resume-visual__top > span {
    display: grid;
    width: 2.35rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid rgb(248 245 238 / 35%);
    border-radius: 0.45rem;
    color: #f8f5ee;
    font-family: var(--font-body);
    font-size: 0.66rem;
    font-weight: 900;
  }

  .resume-visual__top p {
    margin: 0;
    color: rgb(248 245 238 / 59%);
    font-family: var(--font-body);
    font-size: 0.51rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .resume-visual h2 {
    align-self: end;
    margin: 0 0 0.3rem;
    color: #f8f5ee;
    font-size: 3rem;
    letter-spacing: -0.05em;
  }

  .resume-visual > strong {
    color: #d7bc8e;
    font-family: var(--font-body);
    font-size: 0.65rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .resume-visual dl {
    display: grid;
    gap: 0.45rem;
    margin: 1.2rem 0 0;
  }

  .resume-visual dl > div {
    display: grid;
    grid-template-columns: 4.6rem 1fr;
    gap: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid rgb(248 245 238 / 12%);
  }

  .resume-visual dt {
    color: rgb(248 245 238 / 48%);
    font-family: var(--font-body);
    font-size: 0.51rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .resume-visual dd {
    margin: 0;
    color: rgb(248 245 238 / 83%);
    font-family: var(--font-body);
    font-size: 0.59rem;
    font-weight: 700;
  }

  .resume-visual__matrix {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 0.28rem;
    align-self: end;
  }

  .resume-visual__matrix i {
    height: 0.28rem;
    border-radius: 99px;
    background: rgb(248 245 238 / 20%);
  }

  .resume-visual__matrix i:nth-child(2),
  .resume-visual__matrix i:nth-child(5),
  .resume-visual__matrix i:nth-child(7) { background: #d7bc8e; }

  .page-visual--contact {
    padding: 1.1rem;
    background:
      radial-gradient(circle at 18% 12%, rgb(167 122 59 / 22%), transparent 28%),
      linear-gradient(145deg, #fffdf8, #ede7dd);
  }

  .contact-visual {
    min-height: 22rem;
    padding: 1.3rem;
    border: 1px solid rgb(16 24 38 / 10%);
    border-radius: 1rem;
    background: rgb(255 254 250 / 75%);
  }

  .contact-visual__heading {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--bronze);
    font-family: var(--font-body);
    font-size: 0.56rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .contact-visual__heading i {
    width: 1.5rem;
    height: 1px;
    background: currentColor;
  }

  .contact-visual h2 {
    max-width: 8ch;
    margin: 1.9rem 0 1.5rem;
    font-size: 2.35rem;
  }

  .contact-visual ol {
    list-style: none;
  }

  .contact-visual li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.55rem;
    padding: 0.65rem 0;
    border-top: 1px solid var(--border);
  }

  .contact-visual li > span {
    color: var(--bronze);
    font-family: var(--font-body);
    font-size: 0.57rem;
    font-weight: 900;
  }

  .contact-visual strong,
  .contact-visual small {
    display: block;
    font-family: var(--font-body);
  }

  .contact-visual strong {
    color: var(--ink);
    font-size: 0.72rem;
  }

  .contact-visual small {
    margin-top: 0.1rem;
    color: var(--muted);
    font-size: 0.62rem;
  }

  .page-visual--journey {
    padding: 1.1rem;
    background:
      radial-gradient(circle at 82% 14%, rgb(167 122 59 / 15%), transparent 26%),
      linear-gradient(150deg, #f7f3ea, #e9e4da);
  }

  .journey-visual {
    position: relative;
    min-height: 22rem;
    padding: 1rem;
    overflow: hidden;
    border: 1px solid rgb(16 24 38 / 9%);
    border-radius: 1rem;
    background:
      linear-gradient(rgb(16 24 38 / 4%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(16 24 38 / 4%) 1px, transparent 1px),
      #f7f4ed;
    background-size: 1.5rem 1.5rem;
  }

  .journey-visual__heading {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--bronze);
    font-family: var(--font-body);
    font-size: 0.56rem;
    font-weight: 900;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .journey-visual__heading i {
    width: 1.5rem;
    height: 1px;
    background: currentColor;
  }

  .journey-visual__spine {
    position: absolute;
