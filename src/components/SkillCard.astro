---
import type { Skill } from "../data/skills";

interface Props {
  skill: Skill;
}

const { skill } = Astro.props;
---

<article class:list={["skill-card", skill.tier === "learning" && "skill-card--learning"]}>
  <div class="skill-card__top">
    <h3>{skill.name}</h3>
    <span>{skill.level}{skill.tier === "learning" && <em> · Learning</em>}</span>
  </div>

  <p>{skill.description}</p>
</article>