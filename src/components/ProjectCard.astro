---
import type { PortfolioProject } from "../data/projects";
import ProjectPreview from "./ProjectPreview.astro";
import StatusBadge from "./StatusBadge.astro";

interface Props {
  project: PortfolioProject;
}

const { project } = Astro.props;
---

<a class="project-card" href={`/projects/${project.slug}`}>
  <div class="project-card__cover">
    <ProjectPreview variant={project.previewVariant} />
    <div class="project-card__status">
      <StatusBadge label={project.statusLabel} tone={project.accent} />
    </div>
  </div>

  <div class="project-card__body">
    <h3>{project.title}</h3>
    <p class="project-card__tagline">{project.tagline}</p>

    <div class="tag-list project-card__stack" aria-label={`${project.title} technology stack`}>
      {project.stack.slice(0, 3).map((item) => (
        <span class="tag">{item}</span>
      ))}
      {project.stack.length > 3 && (
        <span class="tag tag--muted">+{project.stack.length - 3}</span>
      )}
    </div>

    <span class="project-card__cta">
      View case study
      <span aria-hidden="true">→</span>
    </span>
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--surface);
    text-decoration: none;
    transition:
      transform 200ms ease,
      box-shadow 200ms ease,
      border-color 200ms ease;
  }

  .project-card:hover {
    border-color: rgb(167 122 59 / 45%);
    box-shadow: var(--shadow-card);
    transform: translateY(-5px);
  }

  .project-card__cover {
    position: relative;
  }

  .project-card__cover :global(.project-preview) {
    min-height: 190px;
    border: 0;
    border-radius: 0;
  }

  .project-card__status {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    z-index: 3;
  }

  .project-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: start;
    gap: 0.55rem;
    padding: 1.1rem 1.2rem 1.3rem;
  }

  .project-card__body h3 {
    margin-bottom: 0;
    font-size: 1.5rem;
  }

  .project-card__tagline {
    margin: 0;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .project-card__stack {
    margin-top: 0.15rem;
  }

  .tag--muted {
    color: var(--bronze);
    border-color: rgb(167 122 59 / 30%);
  }

  .project-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.5rem;
    color: var(--ink);
    font-size: 0.72rem;
    font-weight: 900;
  }

  .project-card__cta span {
    color: var(--bronze);
    transition: transform 180ms ease;
  }

  .project-card:hover .project-card__cta span {
    transform: translateX(3px);
  }
</style>
